#version 460
#extension GL_GOOGLE_include_directive : require
#include "hair_physics_common.glsl"

layout(local_size_x=256) in;

void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=HP_GRID_COUNT) return;
    volumeAccum[i].occupancy=0u;
    volumeAccum[i].momentumX=0;
    volumeAccum[i].momentumY=0;
    volumeAccum[i].momentumZ=0;
    volumeState[i]=vec4(0.0);
}
