#version 460
#include "hair_render_common.glsl"

// Each workgroup distributes one guide segment's extinction mass over
// voxels intersecting its support capsule.
layout(local_size_x=128) in;

const uint GUIDE_POINTS=20u;
const uint SEGMENTS_PER_GUIDE=GUIDE_POINTS-1u;
struct Point { vec4 position; };
struct GuidePointMeta { vec4 supportVolume; };
layout(set=2,binding=0,std430) readonly buffer GuideCurrent { Point guideCurrent[]; };
layout(set=2,binding=7,std430) readonly buffer GuideMeta { GuidePointMeta guideMeta[]; };
layout(set=3,binding=1,std430) buffer OpticalDensity { uint opticalSigmaFixed[]; };

shared float partial[128];

int idx(ivec3 c,int dim){ return (c.z*dim+c.y)*dim+c.x; }
float sqDistancePointSegment(vec3 p,vec3 a,vec3 b){
    vec3 ab=b-a;
    float d=max(dot(ab,ab),1e-12);
    float t=clamp(dot(p-a,ab)/d,0.0,1.0);
    vec3 q=a+t*ab;
    vec3 v=p-q;
    return dot(v,v);
}
float compactKernel(float d2,float support){
    float r2=max(support*support,1e-10);
    float x=max(0.0,1.0-d2/r2);
    return x*x;
}

void main(){
    uint segmentId=gl_WorkGroupID.x;
    uint guideId=segmentId/SEGMENTS_PER_GUIDE;
    uint p=segmentId-guideId*SEGMENTS_PER_GUIDE;
    if(guideId>=1600u || p>=SEGMENTS_PER_GUIDE) return;

    uint i0=guideId*GUIDE_POINTS+p;
    uint i1=i0+1u;
    vec3 a=guideCurrent[i0].position.xyz;
    vec3 b=guideCurrent[i1].position.xyz;
    vec3 ab=b-a;
    float len=length(ab);
    if(len<1e-7) return;

    float fibers=max(0.0,0.5*(guideMeta[i0].supportVolume.z+guideMeta[i1].supportVolume.z));
    if(fibers<=1e-4) return;

    int dim=max(int(matl.renderParams.x+0.5),2);
    float cell=max(matl.opticalGrid.w,1e-5);
    float fixedScale=max(matl.renderParams.w,1.0);
    float radius=max(0.5*(guideMeta[i0].supportVolume.x+guideMeta[i1].supportVolume.x),0.5*cell);
    // Optical support uses the finite cross-section of the lock.
    float support=max(radius*max(matl.fiberShape.z,0.5),0.90*cell);

    vec3 lo=(min(a,b)-vec3(support)-matl.opticalGrid.xyz)/cell;
    vec3 hi=(max(a,b)+vec3(support)-matl.opticalGrid.xyz)/cell;
    ivec3 c0=clamp(ivec3(floor(lo)),ivec3(0),ivec3(dim-1));
    ivec3 c1=clamp(ivec3(floor(hi)),ivec3(0),ivec3(dim-1));
    ivec3 ext=c1-c0+ivec3(1);
    uint voxelCount=uint(max(ext.x,0)*max(ext.y,0)*max(ext.z,0));
    if(voxelCount==0u) return;

    float localSum=0.0;
    for(uint linear=gl_LocalInvocationIndex;linear<voxelCount;linear+=gl_WorkGroupSize.x){
        uint xy=uint(ext.x*ext.y);
        int z=int(linear/xy);
        uint rem=linear-uint(z)*xy;
        int y=int(rem/uint(ext.x));
        int x=int(rem-uint(y*ext.x));
        ivec3 c=c0+ivec3(x,y,z);
        vec3 center=matl.opticalGrid.xyz+(vec3(c)+vec3(0.5))*cell;
        localSum+=compactKernel(sqDistancePointSegment(center,a,b),support);
    }
    partial[gl_LocalInvocationIndex]=localSum;
    barrier();
    for(uint stride=64u;stride>0u;stride>>=1u){
        if(gl_LocalInvocationIndex<stride) partial[gl_LocalInvocationIndex]+=partial[gl_LocalInvocationIndex+stride];
        barrier();
    }
    float sumW=partial[0];
    if(sumW<=1e-8) return;

    float rootDiameter=max(matl.fiberShape.x,1e-6);
    float tipScale=clamp(matl.fiberShape.y,0.02,1.0);
    float u=(float(p)+0.5)/float(SEGMENTS_PER_GUIDE);
    float diameter=rootDiameter*mix(1.0,tipScale,u);
    float extinctionMass=diameter*fibers*len;
    float cellVolume=cell*cell*cell;
    float massToFixed=fixedScale/max(sumW*cellVolume,1e-12);

    for(uint linear=gl_LocalInvocationIndex;linear<voxelCount;linear+=gl_WorkGroupSize.x){
        uint xy=uint(ext.x*ext.y);
        int z=int(linear/xy);
        uint rem=linear-uint(z)*xy;
        int y=int(rem/uint(ext.x));
        int x=int(rem-uint(y*ext.x));
        ivec3 c=c0+ivec3(x,y,z);
        vec3 center=matl.opticalGrid.xyz+(vec3(c)+vec3(0.5))*cell;
        float w=compactKernel(sqDistancePointSegment(center,a,b),support);
        uint q=uint(clamp(round(extinctionMass*w*massToFixed),0.0,16777215.0));
        if(q>0u) atomicAdd(opticalSigmaFixed[idx(c,dim)],q);
    }
}
