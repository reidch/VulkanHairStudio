#version 460
#extension GL_GOOGLE_include_directive : require
#include "hair_physics_common.glsl"

// Transfer only the grid *change* back to guide particles (FLIP-like) so the
// volume solve transmits collision pressure without the excessive numerical
// viscosity of pure PIC averaging.  A small PIC blend damps unresolved jitter.
layout(local_size_x=32) in;
const uint GUIDE_POINTS=20u;

struct Point { vec4 position; };
layout(std430,set=2,binding=0) readonly buffer Current { Point cur[]; };
layout(std430,set=2,binding=1) readonly buffer Rest { Point rest[]; };
layout(std430,set=2,binding=3) buffer Velocity { vec4 velocity[]; };

void main(){
    uint guide=gl_WorkGroupID.x;
    uint lane=gl_LocalInvocationIndex;
    if(lane>=GUIDE_POINTS || lane==0u) return;
    uint idx=guide*GUIDE_POINTS+lane;

    vec3 p=cur[idx].position.xyz;
    vec3 v=velocity[idx].xyz;
    vec4 before=hpSampleP2GState(p);
    vec4 after=hpSampleVolumeState(p);
    float target=max(sim.volume.x,0.05);
    float interaction=smoothstep(0.28*target,0.95*target,after.w);
    if(interaction<=0.0 || before.w<=0.0) return;

    // FLIP transports the pressure/contact delta and therefore preserves the
    // particle's own motion.  Eight-percent PIC regularization is enough to
    // suppress grid-scale chatter without merging distinct wisps into a sheet.
    vec3 vFlip=v+(after.xyz-before.xyz);
    vec3 vPic=after.xyz;
    vec3 targetVelocity=mix(vFlip,vPic,0.08);
    vec3 dv=targetVelocity-v;

    uint a=lane>0u?lane-1u:lane;
    uint b=lane+1u<GUIDE_POINTS?lane+1u:lane;
    vec3 T=hpSafeNormalize(cur[guide*GUIDE_POINTS+b].position.xyz-cur[guide*GUIDE_POINTS+a].position.xyz,
                           vec3(0.0,-1.0,0.0));
    vec3 tangential=T*dot(dv,T);
    vec3 lateral=dv-tangential;
    vec3 coupledDelta=max(sim.volume.z,0.0)*interaction*(lateral+0.16*tangential);
    float dLen=length(coupledDelta);
    if(dLen>2.2) coupledDelta*=2.2/dLen;
    v+=coupledDelta;

    float support=guideMeta[idx].x; // same physical proxy radius used by CPU preflight
    float dt=clamp(sim.dtSolver.x,1.0/240.0,1.0/30.0);
    v=hpContactVelocityCoulomb(p,v,support,dt);
    v*=1.0-clamp(rest[idx].position.w,0.0,1.0);
    velocity[idx]=vec4(v,0.0);
}
